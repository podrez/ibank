# ── Alfa-Bank Belarus ─────────────────────────────────────────────────────────
# Enable by setting ALFABANK_LOGIN. Leave empty to disable.
ALFABANK_LOGIN=your_alfabank_login
ALFABANK_PASSWORD=your_alfabank_password

# ── Priorbank Belarus ─────────────────────────────────────────────────────────
# Enable by setting PRIORBANK_LOGIN. Leave empty to disable.
PRIORBANK_LOGIN=
PRIORBANK_PASSWORD=

# ── БелВЭБ (BelVEB) Belarus ───────────────────────────────────────────────────
# Enable by setting BELVEB_LOGIN. Leave empty to disable.
BELVEB_LOGIN=
BELVEB_PASSWORD=

# ── Паритетбанк (Paritetbank) Belarus ─────────────────────────────────────────
# Enable by setting PARITETBANK_LOGIN. Leave empty to disable.
PARITETBANK_LOGIN=
PARITETBANK_PASSWORD=
# Optional: if the account has multiple organisations, specify the name of the
# one to select automatically. Leave empty to pick the first one.
PARITETBANK_ORG=

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./data/accounts.db

# ── REST API ──────────────────────────────────────────────────────────────────
API_PORT=3000
API_KEY=change_this_secret_key
# Sub-path prefix when served behind a reverse proxy (e.g. BASE_PATH=/ibank).
# Leave empty when the app is at the root (/).
BASE_PATH=

# ── Scheduler (cron, workdays 9:00–17:00 local time) ──────────────────────────
SCHEDULE_START_HOUR=9
SCHEDULE_END_HOUR=17
SCHEDULE_INTERVAL_MINUTES=5
# IANA timezone used for scheduling, today-totals API, and browser locale.
APP_TIMEZONE=Europe/Minsk
# Comma-separated dates (YYYY-MM-DD) that are working Sat/Sun due to holiday transfers.
# Example: EXTRA_WORKING_DAYS=2026-04-25,2026-11-07
EXTRA_WORKING_DAYS=

# ── Playwright ────────────────────────────────────────────────────────────────
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
# On ARM64 servers Playwright's bundled Chromium (x86_64) won't run.
# Install the native ARM64 browser (apt install chromium-browser) and set the path:
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ── Statement (выписка) ────────────────────────────────────────────────────────
# Comma-separated account numbers to include in automatic statement sync.
# Leave empty to disable scheduled statement download for that bank.
# Manual download via POST /api/statements/refresh is always available.
ALFABANK_STATEMENT_ACCOUNTS=
PRIORBANK_STATEMENT_ACCOUNTS=
BELVEB_STATEMENT_ACCOUNTS=
PARITETBANK_STATEMENT_ACCOUNTS=

# ── 1C Notification ───────────────────────────────────────────────────────────
# When set, a POST is sent to this URL after new statement transactions are imported.
# Body: { "bank": "alfabank", "account": "BY12..." }
# Headers: Authorization: Basic <base64(user:pass)>, X-Api-Key: <key>
# Leave ONEC_WEBHOOK_URL empty to disable notifications.
ONEC_WEBHOOK_URL=
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_API_KEY=

# ── Debug ─────────────────────────────────────────────────────────────────────
# DEBUG_SCREENSHOTS=true   — saves screenshots/HTML to ./data/debug/ per bank
# LOG_LEVEL=debug
DEBUG_SCREENSHOTS=false
LOG_LEVEL=info

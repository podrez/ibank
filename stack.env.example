# ── Alfa-Bank Belarus ─────────────────────────────────────────────────────────
# Enable by setting ALFABANK_LOGIN. Leave empty to disable.
ALFABANK_LOGIN=
ALFABANK_PASSWORD=

# ── Priorbank Belarus ─────────────────────────────────────────────────────────
# Enable by setting PRIORBANK_LOGIN. Leave empty to disable.
PRIORBANK_LOGIN=
PRIORBANK_PASSWORD=

# ── БелВЭБ (BelVEB) Belarus ───────────────────────────────────────────────────
# Enable by setting BELVEB_LOGIN. Leave empty to disable.
BELVEB_LOGIN=
BELVEB_PASSWORD=

# ── Паритетбанк (Paritetbank) Belarus ─────────────────────────────────────────
# Enable by setting PARITETBANK_LOGIN. Leave empty to disable.
PARITETBANK_LOGIN=
PARITETBANK_PASSWORD=
# Optional: organisation name to select on login (first org used if empty).
PARITETBANK_ORG=

# ── Паритетбанк для физических лиц (iParitet, iparitet.by) ────────────────────
# Retail bank, separate from the corporate Paritetbank above. SMS login is
# required — restore access via the settings UI (Банки → «Вход по SMS»).
IPARITET_LOGIN=
IPARITET_PASSWORD=

# ── REST API ──────────────────────────────────────────────────────────────────
API_KEY=change_this_secret_key
# Port the app listens on inside the container AND the published host port.
# With `docker compose` this must also be set in the `.env` next to
# docker-compose.yml — that file is what Compose interpolates `${API_PORT}` from.
API_PORT=3000

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULE_START_HOUR=9
SCHEDULE_END_HOUR=17
SCHEDULE_INTERVAL_MINUTES=5
# IANA timezone used for scheduling, today-totals, and browser locale.
APP_TIMEZONE=Europe/Minsk
# Comma-separated dates (YYYY-MM-DD) that are working Sat/Sun due to holiday transfers.
EXTRA_WORKING_DAYS=

# ── Playwright ────────────────────────────────────────────────────────────────
BROWSER_TIMEOUT_MS=30000
# On ARM64 servers set path to native Chromium:
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ── Statement (выписка) ────────────────────────────────────────────────────────
ALFABANK_STATEMENT_ACCOUNTS=
PRIORBANK_STATEMENT_ACCOUNTS=
BELVEB_STATEMENT_ACCOUNTS=
PARITETBANK_STATEMENT_ACCOUNTS=
IPARITET_STATEMENT_ACCOUNTS=

# ── 1C Notification ───────────────────────────────────────────────────────────
ONEC_WEBHOOK_URL=
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_API_KEY=

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG_SCREENSHOTS=false
LOG_LEVEL=info
